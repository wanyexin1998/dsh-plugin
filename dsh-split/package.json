{
  "name": "dsh-split",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: a single workbench host that shows several native sessions side by side (split right/down from the per-session menu), one native Sidebar per session.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dockview": "8.5.1",
    "dockview-core": "8.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^7.0.2"
  }
}
