{
  "name": "dsh-dingtalk",
  "version": "0.1.0-dev.6",
  "private": true,
  "description": "DSH DingTalk: local OAuth and read-only identity, calendar and document tools",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "main": "./lib/host/index.js",
  "types": "./lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./shared": {
      "types": "./lib/shared/index.d.ts",
      "default": "./lib/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dws.lock.json",
    "README.md",
    "LICENSE",
    "skills",
    "docs/P0-ACCEPTANCE.md",
    "docs/AUTHORIZATION.md",
    "docs/INSTALL-CONNECT-ACCEPTANCE.md",
    "docs/OAUTH-CALLBACK-ACCEPTANCE.md",
    "docs/QUERY-FEEDBACK-ACCEPTANCE.md",
    "docs/SECURITY-REVIEW.md",
    "docs/G0-feasibility.md",
    "docs/G0-local-validation.md",
    "docs/G0-enterprise-test-plan.md",
    "docs/INSTALL.md",
    "docs/CONTRACT.md",
    "docs/LOCAL-BACKEND.md",
    "docs/SERVER-RUNTIME.md",
    "docs/LINUX-DWS.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@types/node": "22.20.0",
    "@types/react": "18.3.12",
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:p0": "node scripts/verify-p0.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:dsh-web": "node scripts/verify-dsh-web.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "prepack": "npm run build"
  }
}
