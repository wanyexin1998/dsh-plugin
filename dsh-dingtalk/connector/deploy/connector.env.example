# Connector runtime configuration. Copy to connector.env and fill in. Never commit the real file.
# All paths are inside the container. No token, code or secret belongs in this file.

# Private state volume (DWS tokens, per-user HOME/DWS_CONFIG_DIR/keychain, admin token).
DSH_CONNECTOR_STATE_DIR=/var/lib/dsh-dingtalk-connector
# Pinned DWS binary baked into the image.
DSH_CONNECTOR_DWS_BINARY=/opt/dws/bin/dws
DSH_DINGTALK_DWS_LOCK=/app/dws.lock.json

# Production transport: one Unix domain socket per caller under the private volume.
DSH_CONNECTOR_TRANSPORT=unix
# Restrict socket access when callers run as a different UID but share a group. 0600 by default.
# DSH_CONNECTOR_SOCKET_MODE=0660

# Browser OAuth. The public origin must be the exact HTTPS origin served by the TLS proxy;
# trusted origins are the exact DSH web origins allowed to start an authorization.
DSH_CONNECTOR_OAUTH_PUBLIC_ORIGIN=https://dws.example.com
DSH_CONNECTOR_OAUTH_LISTEN_PORT=8787
DSH_CONNECTOR_OAUTH_TRUSTED_ORIGINS=https://dsh.example.com

# Optional explicit egress. DWS subprocesses inherit only these proxy variables.
# DSH_CONNECTOR_PROXY_URL=http://proxy.example:3128
# DSH_CONNECTOR_NO_PROXY=127.0.0.1,localhost,.internal.example

# Execution bounds.
# DSH_CONNECTOR_TIMEOUT_MS=15000
# DSH_CONNECTOR_MAX_OUTPUT_BYTES=262144
# DSH_CONNECTOR_QUEUE_LIMIT=8
# DSH_CONNECTOR_QUEUE_TIMEOUT_MS=5000
# DSH_CONNECTOR_SHUTDOWN_GRACE_MS=5000
