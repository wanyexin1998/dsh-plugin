# Dedicated TLS proxy for the Connector's loopback OAuth listener (http context).
# Raw nginx error messages append request/upstream URLs, even at warn/error severity.
# Discard those request diagnostics at server scope; keep the allowlisted completion log below.
# Global startup/configuration diagnostics remain available. Never enable raw/debug request logs.
map $uri $dsh_oauth_stage {
    default                    other;
    /dsh-dingtalk/start         oauth_start;
    /dsh-dingtalk/callback      oauth_callback;
}
map $status $dsh_oauth_error_code {
    default  http_other;
    ~^2      http_ok;
    ~^3      http_redirect;
    400      request_rejected;
    403      request_forbidden;
    404      route_not_found;
    408      request_timeout;
    413      request_too_large;
    499      client_closed_request;
    500      server_error;
    502      upstream_failed;
    503      service_unavailable;
    504      upstream_timeout;
}
# Only generated IDs, constant enums, numeric statuses and timings. No raw path, query,
# request line, headers, response Location, upstream URL, OAuth transaction or user identity.
log_format dsh_oauth_safe escape=json
    '{"time":"$time_iso8601","request_id":"$request_id",'
    '"stage":"$dsh_oauth_stage","error_code":"$dsh_oauth_error_code",'
    '"status":"$status","upstream_status":"$upstream_status",'
    '"request_time":"$request_time","upstream_connect_time":"$upstream_connect_time",'
    '"upstream_header_time":"$upstream_header_time","upstream_response_time":"$upstream_response_time"}';

server {
    listen 8443 ssl;
    http2 on;
    server_name dws.example.com;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    access_log /dev/stdout dsh_oauth_safe;
    error_log /dev/null;
    # Always use nginx's own random request ID, never the browser's supplied ID.
    add_header X-Request-ID $request_id always;

    # Fixed, exact upstream. No rewrite of paths or query strings.
    location /dsh-dingtalk/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        # Preserve the browser-supplied host:port verbatim. The Connector compares it to the
        # configured public origin exactly, so a non-443 public port survives the proxy while any
        # other Host or port is still rejected upstream.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For '';
        proxy_set_header X-Request-ID $request_id;
        proxy_hide_header X-Request-ID;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 16k;
    }
    location / {
        return 404;
    }
}
