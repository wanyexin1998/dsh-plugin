# Linux-only Connector test image. Assembles the exact runtime layout used in production:
# pinned DWS binary in /opt/dws, Connector bundle, plugin libs and the full connector test suite.
# Build context is prepared by connector/scripts/test-linux.mjs.
FROM node:22-bookworm-slim
ARG DWS_ARCHIVE_SHA256
ARG DWS_BINARY_SHA256
WORKDIR /app
COPY archive.tar.gz /tmp/dws.tar.gz
RUN printf '%s  %s\n' "${DWS_ARCHIVE_SHA256}" /tmp/dws.tar.gz | sha256sum -c - \
 && mkdir -p /opt/dws/bin \
 && tar -xzf /tmp/dws.tar.gz -C /opt/dws/bin --no-same-owner \
 && test -f /opt/dws/bin/dws \
 && printf '%s  %s\n' "${DWS_BINARY_SHA256}" /opt/dws/bin/dws | sha256sum -c - \
 && chmod 0755 /opt/dws/bin/dws \
 && /opt/dws/bin/dws --version
COPY enhancements /app/enhancements
COPY connector /app/connector
RUN chown -R node:node /app /opt/dws && chmod -R a+rX /app /opt/dws
USER node
ENV DSH_TEST_DWS_BINARY=/opt/dws/bin/dws \
    DSH_DINGTALK_DWS_LOCK=/app/enhancements/dws.lock.json \
    HOME=/home/node
WORKDIR /app/connector
CMD ["node", "--test", "--test-concurrency=1", "tests/unit.test.mjs", "tests/linux.test.mjs"]
