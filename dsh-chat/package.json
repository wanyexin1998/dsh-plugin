{
  "name": "dsh-chat",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: a floating 工作 / 聊天 switch that opens the DeepSeek Chat web app inside the DSH GUI, proxied through a loopback bridge so the desktop session works without a second login.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "license": "MIT"
}
