    "dangerousApproval": "dsh-human-only",
    "autoHealingMaxSameFailure": 2,
    "globalShellTool": false
  },
  "channels": {
    "dingtalk": {
      "enabled": false,
      "mode": "application-bot-stream",
      "groupsAllowed": false
    },
    "feishu": {
      "enabled": false,
      "mode": "official-sdk-events",
      "groupsAllowed": false
    }
  },
  "note": "设计示例，不是可直接加载的 DSH config；需 adapter 映射并完成接入探测。所有数字为可调设计初值。"
