{
  "name": "dsh-visualize-inline",
  "version": "0.4.0",
  "private": true,
  "description": "Native inline metrics, progress and charts for DSH Markdown conversations.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:unit": "node --test --test-concurrency=1 tests/protocol.test.mjs tests/guidance.test.mjs tests/scale.test.mjs",
    "test:render": "node --test --test-concurrency=1 tests/render.test.mjs",
    "test:e2e": "node integration/e2e.mjs",
    "test:e2e:v2": "node integration/v2-e2e.mjs",
    "test:e2e:p1": "node integration/p1-e2e.mjs",
    "open": "node integration/open-latest.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild-wasm": "0.28.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.2"
  },
  "license": "UNLICENSED"
}
